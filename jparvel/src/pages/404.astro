---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página no encontrada | JPARVEL" description="La página que buscas no existe o se ha perdido en el hiperespacio.">
  <Header />
  <main class="min-h-screen bg-black text-white flex items-center justify-center pt-28 pb-24">
    <div class="container mx-auto px-6 text-center">
      <p class="text-sw-yellow font-mono text-lg mb-2 tracking-widest">ERROR 404</p>
      <h1 class="text-4xl md:text-6xl font-bold text-bright mb-6 uppercase tracking-wider">
        Esta no es la página que buscas
      </h1>
      <p class="text-gray-300 mb-10 max-w-xl mx-auto">
        Se ha perdido en el hiperespacio. Vuelve a un lugar conocido de la galaxia.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-8 py-3 bg-sw-yellow text-black font-bold text-lg hover:bg-sw-gold transition-all duration-300 uppercase tracking-wider shadow-glow-yellow"
      >
        Volver al Inicio
      </a>
    </div>
  </main>
  <Footer />
</Layout>
