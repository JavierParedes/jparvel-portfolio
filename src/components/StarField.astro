---
// Full-screen moving starfield for pages without cinematic scenes (legal pages, 404).
---

<div id="starfield" class="starfield" aria-hidden="true">
  <canvas id="stars-canvas"></canvas>
</div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 45% at 70% 40%, rgb(60 55 90 / 0.3), transparent 70%),
      radial-gradient(ellipse 45% 35% at 15% 85%, rgb(20 50 70 / 0.22), transparent 70%),
      #02040a;
  }

  #stars-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { SceneEffects } from '../scripts/sceneEffects';

  const canvas = document.getElementById('stars-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let reduced = false;
    try {
      reduced = localStorage.getItem('jparvel:scene-reduced') === 'true';
    } catch {
      /* Storage may be unavailable. */
    }
    const stars = new SceneEffects(canvas, false);
    const apply = () => stars.setEnabled(!(reduced || motion.matches));
    apply();
    motion.addEventListener('change', apply);
    document.addEventListener('visibilitychange', () => stars.setVisible(!document.hidden));
    window.addEventListener('pagehide', (event) => {
      if (event.persisted) stars.setVisible(false);
      else stars.dispose();
    });
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) stars.setVisible(!document.hidden);
    });
  }
</script>
