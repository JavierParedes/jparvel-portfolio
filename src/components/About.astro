---
import { aboutData, aboutCodeCard } from '../data/siteData';

const specialtiesList = aboutCodeCard.specialties.join('", "');
const industriesList = aboutCodeCard.industries.join('", "');
// One property per line, wrapped in line breaks so the braces sit on their own lines.
const codeBody = [
  '',
  `  name: "${aboutCodeCard.name}",`,
  `  role: "${aboutCodeCard.role}",`,
  `  founded: ${aboutCodeCard.founded},`,
  `  headquarters: "${aboutCodeCard.headquarters}",`,
  `  specialties: ["${specialtiesList}"],`,
  `  industries: ["${industriesList}"],`,
  '',
].join('\n');
---

<section id="about" class="scene-section">
  <div class="scene-intro">
    <header class="hud-caption">
      <h2 class="hud-title">{aboutData.title}</h2>
      <p class="hud-subtitle">{aboutData.subtitle}</p>
    </header>
  </div>

  <div class="scene-content">

    <div class="hud-stack hud-stack--about">
      <div class="hud-plate hud-code">
        <p class="hud-kicker">about.js</p>
        <pre class="hud-code-body"><span class="text-sw-yellow font-bold">const</span> about = {"{"}{codeBody}{"};"}</pre>
      </div>

      <div class="hud-plate hud-body">
        <h3 class="hud-block-title">Nuestra Mision</h3>
        <p class="hud-text mb-8">{aboutData.mission}</p>

        <h3 class="hud-block-title">Competencias Clave</h3>
        <div class="hud-readouts">
          {aboutData.skills.map((skill) => (
            <div class="hud-readout">
              <div class="hud-readout-row">
                <span class="hud-readout-label">{skill.name}</span>
                <span class="hud-readout-value">{skill.percentage}%</span>
              </div>
              <div class="hud-meter">
                <div class="hud-meter-fill progress-fill" style={`--target: ${skill.percentage}%;`}></div>
              </div>
            </div>
          ))}
        </div>

        <div class="hud-tags">
          {[...aboutCodeCard.specialties, ...aboutCodeCard.industries].map((tag) => (
            <span class="hud-tag">{tag}</span>
          ))}
        </div>
      </div>

      <div class="hud-stats">
        {aboutData.stats.map((stat) => (
          <div class="hud-plate hud-stat">
            <p class="hud-stat-value">{stat.value}</p>
            <p class="hud-stat-label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
