---
import { Image } from 'astro:assets';
import { servicesData } from '../data/siteData';
import deathStar from '../images/Estrella de la Muerte.png';
import robot from '../images/robot.png';
import tormenta from '../images/tormenta.png';
import sableSith from '../images/sable sith.png';
import astromechAI from '../images/astromech-ai.svg';

const iconMap: Record<string, any> = {
  "Frontend Development": deathStar,
  "Backend Development": robot,
  "UI/UX Design": tormenta,
  "Deployment": sableSith,
  "Artificial Intelligence": astromechAI,
};
---

<section id="services" class="scene-section">
  <div class="scene-intro">
    <header class="hud-caption">
      <h2 class="hud-title">{servicesData.title}</h2>
      <p class="hud-subtitle">{servicesData.subtitle}</p>
      <p class="hud-text">{servicesData.description}</p>
    </header>
  </div>

  <div class="scene-content">

    <div class="hud-grid">
      {servicesData.services.map((service) => (
        <article class:list={['hud-plate', 'hud-system', { 'hud-system--ai': service.icon === 'astromech' }]}>
          <div class="hud-system-icon">
            <Image
              src={iconMap[service.title]}
              alt={service.title}
              inferSize
              class="hud-system-icon-img"
              loading="lazy"
            />
          </div>
          <h3 class="hud-card-title">{service.title}</h3>
          <p class="hud-text hud-text--small">{service.description}</p>
          <ul class="hud-checklist">
            {service.features.map((feature) => (
              <li>
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
