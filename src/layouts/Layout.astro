---
import '../styles/global.css';
import '../styles/scenes.css';
import { siteConfig, aboutCodeCard } from '../data/siteData';
import StarField from '../components/StarField.astro';
import ogDefault from '../images/jparvel-social-preview.jpg';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  background?: 'scenes' | 'stars';
}

const {
  background = 'stars',
  title = siteConfig.name,
  description = siteConfig.description,
  ogImage = ogDefault.src,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const ogImageAlt = `Portada de ${siteConfig.name} — ${aboutCodeCard.role}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": aboutCodeCard.name,
      "jobTitle": aboutCodeCard.role,
      "url": Astro.site?.href,
      "email": `mailto:${siteConfig.email}`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": aboutCodeCard.headquarters,
        "addressCountry": "ES",
      },
      "sameAs": [siteConfig.social.github, siteConfig.social.linkedin],
    },
    {
      "@type": "WebSite",
      "name": siteConfig.name,
      "url": Astro.site?.href,
      "description": siteConfig.description,
      "inLanguage": "es",
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImage === ogDefault.src && (
      <>
        <meta property="og:image:width" content={String(ogDefault.width)} />
        <meta property="og:image:height" content={String(ogDefault.height)} />
        <meta property="og:image:type" content="image/jpeg" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body data-background={background} class="antialiased bg-black text-white overflow-x-hidden">
    <!-- Star Wars starfield background -->
    {background === 'stars' && <StarField />}

    <slot name="background" />

    <!-- Main content with z-index above starfield -->
    <div class="relative z-10 site-content">
      <slot />
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Animar barras solo cuando entren en viewport
        const animatedBars = document.querySelectorAll('.progress-animated, .progress-fill, .skill-bar');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('animate-progress');
                entry.target.classList.add('animate-fill');
              }
            });
          },
          { threshold: 0.3 }
        );

        animatedBars.forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
